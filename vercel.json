{
  "version": 2,
  "buildCommand": "npm run build:app",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "functions": {
    "api/engagement-cron.ts": { "maxDuration": 300 },
    "api/**/*.ts": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "crons": [{ "path": "/api/engagement-cron", "schedule": "0 10 * * *" }],
  "rewrites": [
    { "source": "/private/morphly/login", "destination": "/private/morphly/login/index.html" },
    { "source": "/reset-password", "destination": "/reset-password/index.html" },
    { "source": "/api/admin-me", "destination": "/api/admin?name=me" },
    { "source": "/api/admin-overview", "destination": "/api/admin?name=overview" },
    { "source": "/api/admin-referrals", "destination": "/api/admin?name=referrals" },
    { "source": "/api/admin-users", "destination": "/api/admin?name=users" },
    { "source": "/api/admin-credit-packages", "destination": "/api/admin?name=credit-packages" },
    { "source": "/api/admin-audit-log", "destination": "/api/admin?name=audit-log" },
    { "source": "/api/admin-transactions", "destination": "/api/admin?name=transactions" },
    { "source": "/api/admin-usage", "destination": "/api/admin?name=usage" },
    { "source": "/api/admin-logs", "destination": "/api/admin?name=logs" },
    { "source": "/api/(.*)", "destination": "/api/$1" }
  ],
  "headers": [
    {
      "source": "/private/morphly/login",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    },
    {
      "source": "/private/morphly/login/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" }
      ]
    }
  ]
}
